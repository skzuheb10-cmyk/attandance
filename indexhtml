<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Attendance Tracker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Custom smooth transitions */
        .fade-in {
            animation: fadeIn 0.3s ease-in-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200">

    <!-- MAIN APP CONTAINER -->
    <div id="app" class="flex-grow flex flex-col">
        <!-- Content dynamically injected via JS -->
    </div>

    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // --- STATE MANAGEMENT ---
        const State = {
            currentView: 'auth', // 'auth', 'dashboard', 'profile'
            authMode: 'signin', // 'signin', 'signup'
            user: JSON.parse(localStorage.getItem('app_user')) || null,
            courses: JSON.parse(localStorage.getItem('app_courses')) || [
                { id: '1', name: 'Principles of Management', attended: 22, total: 28 },
                { id: '2', name: 'Financial Accounting', attended: 18, total: 26 },
                { id: '3', name: 'Business Economics', attended: 25, total: 30 },
                { id: '4', name: 'Business Communication', attended: 14, total: 20 }
            ],
            darkMode: localStorage.getItem('app_dark') === 'true',
            forgotModalOpen: false,
            editCourseId: null
        };

        // Initialize Dark Mode class on HTML root
        function updateTheme() {
            const html = document.documentElement;
            if (State.darkMode) {
                html.classList.add('dark');
                localStorage.setItem('app_dark', 'true');
            } else {
                html.classList.remove('dark');
                localStorage.setItem('app_dark', 'false');
            }
        }
        updateTheme();

        // Save courses to localStorage
        function saveCourses() {
            localStorage.setItem('app_courses', JSON.stringify(State.courses));
        }

        // Save user to localStorage
        function saveUser() {
            localStorage.setItem('app_user', JSON.stringify(State.user));
            if (State.user) {
                State.currentView = 'dashboard';
            } else {
                State.currentView = 'auth';
            }
            render();
        }

        // --- RENDER CONTROLLER ---
        function render() {
            const app = document.getElementById('app');
            app.innerHTML = '';

            if (!State.user) {
                app.innerHTML = renderAuthView();
            } else {
                // Layout with Navbar for logged-in users
                app.innerHTML = `
                    ${renderNavbar()}
                    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 fade-in">
                        ${State.currentView === 'dashboard' ? renderDashboardView() : renderProfileView()}
                    </main>
                    ${renderFooter()}
                `;
            }
            attachEventHandlers();
        }

        // --- VIEWS ---

        function renderNavbar() {
            return `
                <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-30 shadow-xs">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                        <div class="flex items-center space-x-3 cursor-pointer" onclick="switchView('dashboard')">
                            <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold shadow-md shadow-indigo-500/20">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>
                            <div>
                                <h1 class="font-bold text-lg leading-tight tracking-tight">Student Portal</h1>
                                <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Attendance & 75% Tracker</p>
                            </div>
                        </div>

                        <div class="flex items-center space-x-3">
                            <button onclick="toggleDarkMode()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition" title="Toggle Theme">
                                <i class="fa-solid ${State.darkMode ? 'fa-sun text-amber-400' : 'fa-moon text-indigo-600'}"></i>
                            </button>
                            
                            <div class="flex items-center space-x-2 pl-2 border-l border-slate-200 dark:border-slate-800">
                                <button onclick="switchView('${State.currentView === 'dashboard' ? 'profile' : 'dashboard'}')" 
                                    class="flex items-center space-x-2 px-3 py-2 rounded-xl text-sm font-medium transition ${State.currentView === 'profile' ? 'bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400' : 'hover:bg-slate-100 dark:hover:bg-slate-800'}">
                                    <div class="w-7 h-7 rounded-full bg-indigo-100 dark:bg-indigo-900 text-indigo-600 dark:text-indigo-300 flex items-center justify-center font-bold text-xs">
                                        ${State.user.name.charAt(0).toUpperCase()}
                                    </div>
                                    <span class="hidden sm:inline">${State.user.name}</span>
                                </button>
                                <button onclick="logout()" class="p-2.5 rounded-xl text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition" title="Sign Out">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </header>
            `;
        }

        function renderAuthView() {
            return `
                <div class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-indigo-50 via-slate-50 to-blue-100 dark:from-slate-950 dark:via-slate-900 dark:to-indigo-950">
                    <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200/80 dark:border-slate-800 p-8 fade-in relative overflow-hidden">
                        
                        <!-- Top Accent Bar -->
                        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-indigo-500 via-blue-500 to-indigo-600"></div>

                        <div class="text-center mb-8">
                            <div class="w-14 h-14 bg-indigo-600 text-white rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-lg shadow-indigo-500/30 mb-4">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>
                            <h2 class="text-2xl font-bold tracking-tight">Student Attendance Portal</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage courses and calculate 75% rule requirements</p>
                        </div>

                        <!-- Tab Selector -->
                        <div class="flex rounded-xl bg-slate-100 dark:bg-slate-800 p-1 mb-6">
                            <button onclick="setAuthMode('signin')" class="flex-1 py-2 text-sm font-semibold rounded-lg transition ${State.authMode === 'signin' ? 'bg-white dark:bg-slate-700 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200'}">
                                Sign In
                            </button>
                            <button onclick="setAuthMode('signup')" class="flex-1 py-2 text-sm font-semibold rounded-lg transition ${State.authMode === 'signup' ? 'bg-white dark:bg-slate-700 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'text-slate-500 hover:text-slate-800 dark:hover:text-slate-200'}">
                                Sign Up
                            </button>
                        </div>

                        ${State.authMode === 'signin' ? `
                            <form onsubmit="handleSignIn(event)" class="space-y-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Email Address</label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-envelope"></i></span>
                                        <input type="email" id="signin-email" required placeholder="student@college.edu" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400 transition">
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-center justify-between mb-1.5">
                                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Password</label>
                                        <button type="button" onclick="openForgotModal()" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Forgot Password?</button>
                                    </div>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-lock"></i></span>
                                        <input type="password" id="signin-pass" required placeholder="••••••••" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400 transition">
                                    </div>
                                </div>
                                <button type="submit" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-500/25 transition">
                                    Sign In to Portal
                                </button>
                            </form>
                        ` : `
                            <form onsubmit="handleSignUp(event)" class="space-y-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Full Name</label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-user"></i></span>
                                        <input type="text" id="signup-name" required placeholder="Aarav Sharma" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400 transition">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Email Address</label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-envelope"></i></span>
                                        <input type="email" id="signup
